# Copy to .env and customize. NEVER commit .env.

# Anthropic API key for the sampling handler (the client pays for tokens).
# ANTHROPIC_API_KEY=sk-ant-...

# Default server when --server is not passed.
MCP_CLIENT_DEFAULT_SERVER=http://127.0.0.1:8080/mcp

# Skip the human confirmation before serving sampling requests (demos only).
MCP_CLIENT_AUTO_APPROVE_SAMPLING=false

# Probe servers for MCP 2026-07-28 (server/discover) before falling back to
# the legacy SDK initialize path.
MCP_CLIENT_MODERN_FIRST=true

# Optional: HTTPS URL of a hosted CIMD client metadata document. When the
# authorization server advertises client_id_metadata_document_supported,
# this URL becomes the OAuth client_id (no dynamic registration).
# MCP_CLIENT_CLIENT_METADATA_URL=https://example.com/oauth/client-metadata.json

# Optional: file:// roots served for MRTR roots/list requests (deprecated
# feature, SEP-2577). JSON list syntax.
# MCP_CLIENT_STATIC_ROOTS=["file:///Users/me/projects/demo"]
