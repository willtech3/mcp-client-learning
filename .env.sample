# Copy to .env and customize. NEVER commit .env.

# Anthropic API key for the sampling handler (the client pays for tokens).
# ANTHROPIC_API_KEY=sk-ant-...

# Default server when --server is not passed.
MCP_CLIENT_DEFAULT_SERVER=http://127.0.0.1:8080/mcp

# Skip the human confirmation before serving sampling requests (demos only).
MCP_CLIENT_AUTO_APPROVE_SAMPLING=false
